# Match data - too big for git, and not ours to redistribute.
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv

# Model weights - fetched by ultralytics on first use.
*.pt
*.pth
*.onnx

# Per-match outputs and anything produced by a run. None of this is part of
# the system: it is one person's working data for one game.
gallery*/
court*.json
predictions*.json
*_predictions.json
labels*.csv
thrower_labels.csv
review*/
*.json.tmp
*.csv.tmp
*.bak
*.bak.*

# Per-match config files. The two examples below are tracked deliberately;
# any other config/*.json is somebody's own game and stays on their machine.
config/*.json
!config/example.json
!config/paralympics24_isr_chn.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Editors and OS
.idea/
.vscode/
.DS_Store
